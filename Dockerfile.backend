
# Minimal Dockerfile for a PHP/Laravel app (scaffold).
FROM php:8.1-cli

# Install system deps and composer
RUN apt-get update && apt-get install -y     git     unzip     libzip-dev     zip     && docker-php-ext-install pdo pdo_mysql zip

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy app files (mounted in docker-compose, this is mostly for build)
COPY backend/ /var/www/html/

# Install composer dependencies (if composer.json exists)
# RUN composer install --no-interaction --prefer-dist --optimize-autoloader

# Expose port for php artisan serve
EXPOSE 8000

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
